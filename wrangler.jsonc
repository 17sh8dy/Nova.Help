{
  // Nova.Help on Cloudflare Workers.
  //
  // DEPLOYED 2026-09-10, on the free workers.dev subdomain — no custom domain, on purpose:
  // Brandon isn't buying nova.help (or any domain) for this right now, so Cloudflare's free
  // "random" URL is the real answer, not a placeholder for one. Live at
  // https://nova-help.17sh8dy.workers.dev. The real R2 bucket and D1 database exist and the
  // schema is applied (2026-09-03) — verified by filing a real ticket with an attachment
  // against them directly and reading both the D1 row and the R2 object back — and
  // NOVA_HELP_SECRET is a real secret on the account (`wrangler secret list` confirms it, set
  // 2026-09-03). See docs/CLOUDFLARE.md.
  //
  // A `nova.help` zone *was* added to this account 2026-09-03, but its status is still
  // "pending" (activation_failure_reason: "unresolvable") — the domain doesn't resolve
  // anywhere, meaning it was never actually registered at a registrar. Workers Custom Domains
  // turn out not to need an *active* zone to attach (only an *existing* one) — a domain binding
  // was created successfully against the pending zone during this same session — but it can
  // never actually serve traffic until the zone goes active, which needs the domain bought and
  // its nameservers pointed at Cloudflare's. That attempt was torn back down; if nova.help (or
  // any domain) is ever bought for this, point its nameservers at `liz.ns.cloudflare.com` /
  // `norm.ns.cloudflare.com`, wait for the zone to go "active", then add the `routes` block
  // back (git history has the exact shape) and redeploy.
  //
  // To exercise the real R2 + D1 without deploying: `wrangler dev --remote` no longer supports
  // Durable Objects (which RATE_LIMITER is), so add "remote": true to the d1_databases and
  // r2_buckets entries below, run plain `wrangler dev`, then revert — the Durable Object still
  // runs local either way, and this repo's default dev experience should stay fully local.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-help",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-08-01",
  // No routes/custom domain configured — that leaves the free workers.dev subdomain as the
  // default deploy target, which is exactly what's wanted here. Explicit rather than implicit,
  // so a reader doesn't have to know wrangler's default to know this is deliberate.
  "workers_dev": true,

  // The app is ESM and uses node:crypto, node:buffer and friends throughout.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // public/ is served by the assets binding rather than by lib/static.mjs, which needs a
  // filesystem. `run_worker_first` keeps the Worker in charge of routing: an asset is answered
  // only when the path really is one.
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-help",
      // The real production database, created 2026-09-03 with `wrangler d1 create nova-help`
      // (region WNAM). Schema applied — see docs/CLOUDFLARE.md.
      "database_id": "60b37c5d-0992-4d35-831a-a1fa1bdceb7f"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "nova-help-attachments"
    }
  ],

  // One object per limiter per key, holding a fixed-window counter. NOT the `ratelimits`
  // binding: its period must be 10 or 60 seconds and every window here is ten minutes to an
  // hour, it returns only `{ success }` so there is no Retry-After to report, and it cannot
  // reset a key, which is what a correct password does here. See server/rateLimiterObject.mjs.
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterObject"
      }
    ]
  },

  // SQLite-backed classes, which is the only option for new namespaces.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiterObject"]
    }
  ],

  "vars": {
    // The public origin, used to build OAuth redirect URIs. This is the real, deployed value —
    // `wrangler dev` doesn't read it: `.dev.vars` carries a `NOVA_HELP_ORIGIN=http://localhost:8787`
    // override that Wrangler prefers for local runs, the same way it already does for
    // NOVA_HELP_SECRET. Editing this value by hand before every deploy and reverting it after
    // was the alternative, and it is exactly the kind of manual step that regresses production
    // the day someone forgets it.
    "NOVA_HELP_ORIGIN": "https://nova-help.17sh8dy.workers.dev"
  }

  // NOVA_HELP_SECRET, NOVA_GOOGLE_CLIENT_ID and NOVA_GOOGLE_SECRET are secrets, never vars.
  // For `wrangler dev` they are read from .dev.vars, which is gitignored.
}
