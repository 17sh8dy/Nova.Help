{
  "name": "@nova/account-client",
  "version": "1.0.0",
  "private": true,
  "description": "The Nova Account client - what an installed Nova product uses to sign somebody in. Zero dependencies.",
  "type": "module",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./storage": {
      "types": "./storage.d.mts",
      "default": "./storage.mjs"
    },
    "./storage/node": {
      "types": "./nodeStorage.d.mts",
      "default": "./nodeStorage.mjs"
    }
  },
  "files": [
    "*.mjs",
    "*.d.mts"
  ],
  "engines": {
    "node": ">=18"
  }
}
